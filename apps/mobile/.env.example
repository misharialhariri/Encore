# Expo inlines any EXPO_PUBLIC_* var into the JS bundle at build time.
# Point this at the Encore API — use your machine's LAN IP (not localhost)
# when testing on a physical device via Expo Go.
EXPO_PUBLIC_API_URL=http://localhost:4000/api
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Read by app.config.js at build/prebuild time (not inlined into the JS
# bundle) — used to configure the native Google Maps SDK for the meetup
# location picker. Without it, maps render blank/unstyled tiles.
GOOGLE_MAPS_API_KEY=
