# Database
DATABASE_URL="postgresql://encore:encore_dev_password@localhost:5432/encore?schema=public"

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# OTP
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# Unifonic (SMS / OTP delivery)
UNIFONIC_APP_SID=replace-with-unifonic-app-sid
UNIFONIC_SENDER_ID=Encore

# AWS S3 (dress + profile photos)
AWS_REGION=me-south-1
AWS_S3_BUCKET=encore-media
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_S3_CDN_BASE_URL=https://cdn.encore.example

# Google Sign-In
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id

# Apple Sign-In
APPLE_CLIENT_ID=com.encore.app
