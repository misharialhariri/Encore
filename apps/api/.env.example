# Database
DATABASE_URL="postgresql://encore:encore_dev_password@localhost:5432/encore?schema=public"

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# OTP
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# Unifonic (SMS / OTP delivery)
UNIFONIC_APP_SID=replace-with-unifonic-app-sid
UNIFONIC_SENDER_ID=Encore

# AWS S3 (dress + profile photos)
AWS_REGION=me-south-1
AWS_S3_BUCKET=encore-media
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_S3_CDN_BASE_URL=https://cdn.encore.example

# Google Sign-In
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id

# Apple Sign-In
APPLE_CLIENT_ID=com.encore.app

# Moyasar (payments — card, Apple Pay, STC Pay via hosted Invoice checkout)
# Without a secret key, checkout falls back to a dev-only "simulate payment"
# flow so the order lifecycle stays testable locally — see services/moyasar.ts
MOYASAR_SECRET_KEY=
# Public base URL Moyasar redirects back to after a hosted checkout — must
# be reachable from the buyer's device (use ngrok/similar for local testing
# on a physical phone; localhost is fine for the simulator/emulator).
API_PUBLIC_URL=http://localhost:4000

# Firebase Cloud Messaging (push notifications) — paste the entire
# downloaded service-account JSON key as a single-line string. Without it,
# pushes are logged to the console instead of sent — see services/push.ts
FCM_SERVICE_ACCOUNT_JSON=
